<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Balance Sheet Dashboard</title>
    <style>
        :root {
            --bg: #0f172a;
            --card-bg: #1e293b;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
            --green: #22c55e;
            --red: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            margin-bottom: 24px;
        }

        h1 {
            font-size: 1.8rem;
            margin-bottom: 4px;
        }

        p.subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .metric-card {
            background-color: var(--card-bg);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid var(--border);
        }

        .metric-card h3 {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .metric-card .value {
            font-size: 1.6rem;
            font-weight: 700;
        }

        .main-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 24px;
        }

        @media (max-width: 850px) {
            .main-layout {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background-color: var(--card-bg);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid var(--border);
            margin-bottom: 24px;
        }

        .card h2 {
            font-size: 1.2rem;
            margin-bottom: 16px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        input, select {
            width: 100%;
            padding: 10px;
            background-color: var(--bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text);
            font-size: 0.95rem;
        }

        input:focus, select:focus {
            outline: none;
            border-color: var(--accent);
        }

        button.btn-submit {
            width: 100%;
            padding: 12px;
            background-color: var(--accent);
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            margin-top: 8px;
        }

        button.btn-submit:hover {
            background-color: var(--accent-hover);
        }

        .table-container {
            overflow-x: auto;
            margin-bottom: 16px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }

        th {
            background-color: var(--bg);
            color: var(--text-muted);
            font-weight: 600;
            padding: 12px;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 12px;
            border-bottom: 1px solid var(--border);
        }

        .text-green { color: var(--green); }
        .text-red { color: var(--red); }

        .btn-delete {
            background: none;
            border: none;
            color: var(--red);
            cursor: pointer;
            font-size: 0.85rem;
        }

        .btn-delete:hover {
            text-decoration: underline;
        }

        .empty-state {
            text-align: center;
            color: var(--text-muted);
            padding: 20px;
        }

        .balance-check {
            padding: 12px 16px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.9rem;
            text-align: center;
            margin-top: 12px;
        }

        .balanced {
            background-color: rgba(34, 197, 94, 0.15);
            color: var(--green);
            border: 1px solid var(--green);
        }

        .unbalanced {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--red);
            border: 1px solid var(--red);
        }
    </style>
</head>
<body>

    <header>
        <h1>Balance Sheet Tracker</h1>
        <p class="subtitle">Track Assets, Liabilities, and Equity to monitor financial position.</p>
    </header>

    <section class="metrics-grid">
        <div class="metric-card">
            <h3>Total Assets</h3>
            <div class="value text-green" id="totalAssets">$0.00</div>
        </div>
        <div class="metric-card">
            <h3>Total Liabilities</h3>
            <div class="value text-red" id="totalLiabilities">$0.00</div>
        </div>
        <div class="metric-card">
            <h3>Total Equity</h3>
            <div class="value" id="totalEquity">$0.00</div>
        </div>
        <div class="metric-card">
            <h3>Working Capital</h3>
            <div class="value" id="workingCapital">$0.00</div>
        </div>
    </section>

    <main class="main-layout">
        <section class="card">
            <h2>Add Entry</h2>
            <form id="balanceForm">
                <div class="form-group">
                    <label for="name">Item Name</label>
                    <input type="text" id="name" required placeholder="e.g. Cash, Equipment, Bank Loan">
                </div>
                <div class="form-group">
                    <label for="category">Category</label>
                    <select id="category" required>
                        <option value="asset">Asset (What you own)</option>
                        <option value="liability">Liability (What you owe)</option>
                        <option value="equity">Equity (Owner's share)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="amount">Amount ($)</label>
                    <input type="number" id="amount" step="0.01" min="0.01" required placeholder="1000.00">
                </div>
                <button type="submit" class="btn-submit">Add Entry</button>
            </form>

            <div id="balanceCheck" class="balance-check balanced">
                Assets = Liabilities + Equity
            </div>
        </section>

        <section>
            <div class="card">
                <h2>Assets</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="assetsBody"></tbody>
                    </table>
                    <div id="emptyAssets" class="empty-state">No assets added.</div>
                </div>
            </div>

            <div class="card">
                <h2>Liabilities</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="liabilitiesBody"></tbody>
                    </table>
                    <div id="emptyLiabilities" class="empty-state">No liabilities added.</div>
                </div>
            </div>

            <div class="card">
                <h2>Equity</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="equityBody"></tbody>
                    </table>
                    <div id="emptyEquity" class="empty-state">No equity added.</div>
                </div>
            </div>
        </section>
    </main>

    <script>
        let entries = JSON.parse(localStorage.getItem('balance_sheet_entries')) || [];

        const balanceForm = document.getElementById('balanceForm');

        function updateTotals() {
            let assets = 0;
            let liabilities = 0;
            let equity = 0;

            entries.forEach(item => {
                if (item.category === 'asset') assets += item.amount;
                if (item.category === 'liability') liabilities += item.amount;
                if (item.category === 'equity') equity += item.amount;
            });

            document.getElementById('totalAssets').textContent = `$${assets.toFixed(2)}`;
            document.getElementById('totalLiabilities').textContent = `$${liabilities.toFixed(2)}`;
            document.getElementById('totalEquity').textContent = `$${equity.toFixed(2)}`;
            
            const workingCapital = assets - liabilities;
            const wcEl = document.getElementById('workingCapital');
            wcEl.textContent = `$${workingCapital.toFixed(2)}`;
            wcEl.className = `value ${workingCapital >= 0 ? 'text-green' : 'text-red'}`;

            // Accounting Equation Check: Assets = Liabilities + Equity
            const balanceCheckEl = document.getElementById('balanceCheck');
            const totalLiabEq = liabilities + equity;
            const diff = Math.abs(assets - totalLiabEq);

            if (diff < 0.01) {
                balanceCheckEl.textContent = "Balanced: Assets = Liabilities + Equity";
                balanceCheckEl.className = "balance-check balanced";
            } else {
                balanceCheckEl.textContent = `Unbalanced: Difference of $${diff.toFixed(2)}`;
                balanceCheckEl.className = "balance-check unbalanced";
            }
        }

        function renderTables() {
            const assetsBody = document.getElementById('assetsBody');
            const liabilitiesBody = document.getElementById('liabilitiesBody');
            const equityBody = document.getElementById('equityBody');

            assetsBody.innerHTML = '';
            liabilitiesBody.innerHTML = '';
            equityBody.innerHTML = '';

            let counts = { asset: 0, liability: 0, equity: 0 };

            entries.forEach((item, index) => {
                counts[item.category]++;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${escapeHtml(item.name)}</strong></td>
                    <td>$${item.amount.toFixed(2)}</td>
                    <td><button class="btn-delete" onclick="deleteEntry(${index})">Delete</button></td>
                `;

                if (item.category === 'asset') assetsBody.appendChild(tr);
                else if (item.category === 'liability') liabilitiesBody.appendChild(tr);
                else if (item.category === 'equity') equityBody.appendChild(tr);
            });

            document.getElementById('emptyAssets').style.display = counts.asset === 0 ? 'block' : 'none';
            document.getElementById('emptyLiabilities').style.display = counts.liability === 0 ? 'block' : 'none';
            document.getElementById('emptyEquity').style.display = counts.equity === 0 ? 'block' : 'none';
        }

        function addEntry(e) {
            e.preventDefault();

            const name = document.getElementById('name').value;
            const category = document.getElementById('category').value;
            const amount = parseFloat(document.getElementById('amount').value);

            entries.push({ name, category, amount });
            saveAndRefresh();
            balanceForm.reset();
        }

        function deleteEntry(index) {
            entries.splice(index, 1);
            saveAndRefresh();
        }

        function saveAndRefresh() {
            localStorage.setItem('balance_sheet_entries', JSON.stringify(entries));
            renderTables();
            updateTotals();
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        balanceForm.addEventListener('submit', addEntry);

        // Initial Load
        renderTables();
        updateTotals();
    </script>
</body>
</html>
